{
  "version": 2,
  "builds": [
    {
      "src": "internship/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "static/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "internship/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/internship/cron/send-emails/",
      "schedule": "*/10 * * * *"
    }
  ]
}
